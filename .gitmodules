[submodule ".vim/pack/minpac/opt/minpac"]
	path = default/vim/pack/minpac/opt/minpac
	url = https://github.com/k-takata/minpac.git
[submodule "fisher"]
	path = fisher
	url = https://github.com/jorgebucaran/fisher
	branch = main
[submodule "dotpy"]
	path = dotpy
	url = https://github.com/vincentqb/dot.py
[submodule "config/nvim/pack/minpac/opt/minpac"]
	path = config/nvim/pack/minpac/opt/minpac
	url = https://github.com/k-takata/minpac.git
